# Database (Prisma) - Update with your Supabase credentials
DATABASE_URL="postgresql://postgres.xxx:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.xxx:password@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase - Update with your project credentials
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Stripe - Update with your Stripe credentials
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT - Generate a secure random string
JWT_SECRET=your_jwt_secret_here

# Frontend
FRONTEND_URL=http://localhost:3000

# AWS
AWS_REGION=us-east-1

# Environment
NODE_ENV=development

# Server
PORT=3001

# Logging (optional)
LOG_LEVEL=info

# AI Resume Import Configuration
# OpenAI API key for resume parsing (required for AI import feature)
OPENAI_API_KEY=sk-your_openai_api_key_here

# AI model to use (default: gpt-4o-mini for cost-effectiveness)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo
AI_MODEL=gpt-4o-mini

# AI request timeout in milliseconds (default: 20000 = 20 seconds)
AI_TIMEOUT=20000

# Maximum number of retries for AI requests (default: 2)
AI_MAX_RETRIES=2

# Maximum file size for uploads in bytes (default: 10485760 = 10MB)
MAX_FILE_SIZE=10485760

# Rate limiting for AI imports per user
# Number of imports allowed per time window (default: 5)
IMPORT_RATE_LIMIT=5

# Rate limit time window in milliseconds (default: 3600000 = 1 hour)
IMPORT_RATE_WINDOW=3600000

# Cache TTL for duplicate imports in milliseconds (default: 3600000 = 1 hour)
CACHE_TTL=3600000

{
  "name": "resumebuilderbackend",
  "version": "1.0.0",
  "description": "Serverless backend API for the ATS-Friendly Resume Builder application.",
  "main": "dist/handlers/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:watch": "nodemon",
    "dev:direct": "serverless offline",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/nodemon",
    "build": "prisma generate",
    "deploy:dev": "npm run build && DOTENV_CONFIG_PATH=.env.dev node -r dotenv/config node_modules/.bin/serverless deploy --stage dev",
    "deploy:prod": "npm run build && DOTENV_CONFIG_PATH=.env.prod node -r dotenv/config node_modules/.bin/serverless deploy --stage production",
    "remove:dev": "DOTENV_CONFIG_PATH=.env.dev node -r dotenv/config node_modules/.bin/serverless remove --stage dev",
    "remove:prod": "DOTENV_CONFIG_PATH=.env.prod node -r dotenv/config node_modules/.bin/serverless remove --stage production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:studio:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config node_modules/.bin/prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "sync:users": "ts-node scripts/sync-users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.0",
    "@sparticuz/chromium": "^143.0.0",
    "@supabase/supabase-js": "^2.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "nanoid": "^3.3.11",
    "pg": "^8.16.3",
    "puppeteer-core": "^24.34.0",
    "serverless-http": "^4.0.0",
    "stripe": "^17.7.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.157",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.13",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "serverless": "^4.22.0",
    "serverless-esbuild": "^1.56.0",
    "serverless-offline": "^14.4.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
